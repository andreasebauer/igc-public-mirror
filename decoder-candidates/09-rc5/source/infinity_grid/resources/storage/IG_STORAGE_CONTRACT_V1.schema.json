        "collection_kind": {
          "minLength": 1,
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "depth": {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/PageEntry"
          },
          "minItems": 0,
          "type": "array"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "minItems": 0,
          "type": "array"
        },
        "first_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "key_definition_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "last_key": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "purpose": {
          "enum": [
            "SCIENCE",
            "SCHEMA_FIXTURE"
          ],
          "type": "string"
        },
        "record_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "record_schema_id": {
          "minLength": 1,
          "type": "string"
        },
        "schema_id": {
          "const": "IG_STORAGE_COLLECTIONPAGE_V1"
        }
      },
      "required": [
        "schema_id",
        "contract_version",
        "purpose",
        "collection_kind",
        "record_schema_id",
        "key_definition_ref",
        "depth",
        "first_key",
        "last_key",
        "record_count",
        "entries",
        "extensions"
      ],
      "type": "object"
    },
    "CollectionRef": {
      "additionalProperties": false,
      "description": "Bounded immutable page-tree root; row_count counts physical records, not scientific population.",
      "properties": {
        "cardinality_semantics": {
          "enum": [
            "SET",
            "MULTISET",
            "ORDERED",
            "OCCURRENCE_LOG"
          ],
          "type": "string"
        },
        "key_definition_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "record_schema_id": {
          "minLength": 1,
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/ContentRef"
        },
