        "comparison_ref": {
          "$ref": "#/$defs/OptionalFieldRef"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "counting_unit": {
          "minLength": 1,
          "type": "string"
        },
        "distinct_tested_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "domain_definition_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "domain_kind": {
          "enum": [
            "EXHAUSTIVE_DECLARED_DOMAIN",
            "BOUNDED_PANEL",
            "SAMPLED",
            "NOT_EVALUATED"
          ],
          "type": "string"
        },
        "expected_count": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
