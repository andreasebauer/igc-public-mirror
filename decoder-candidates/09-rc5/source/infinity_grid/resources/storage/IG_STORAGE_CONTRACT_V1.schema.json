        "contract_version",
        "purpose",
        "scope",
        "origin_mode",
        "science_execution",
        "domain_kind",
        "domain_definition_ref",
        "counting_unit",
        "expected_count",
        "distinct_tested_count",
        "raw_attempt_count",
        "passed_count",
        "failed_count",
        "skipped_count",
        "not_run_count",
        "outcome",
        "comparison_ref",
        "nonclaims",
        "extensions"
