          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "root",
        "record_schema_id",
        "row_count",
        "key_definition_ref",
        "cardinality_semantics"
      ],
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "description": "SHA-256 and exact length of stored raw bytes; neither value is a scientific object ID.",
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "Coverage is scoped. Complete declared panel is not an unbounded census; attempts never inflate distinct coverage.",
