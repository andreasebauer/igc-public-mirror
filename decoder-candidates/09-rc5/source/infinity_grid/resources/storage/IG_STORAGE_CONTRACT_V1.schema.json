{
  "$defs": {
    "Block": {
      "additionalProperties": false,
      "description": "One independent decode unit; no prior compressed block needed. Codec dictionaries are explicit dependencies.",
      "properties": {
        "codec_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "contract_version": {
          "const": "1.0.0"
        },
        "decoded_content": {
          "$ref": "#/$defs/ContentRef"
        },
        "decoded_offset": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "minItems": 0,
          "type": "array"
        },
        "ordinal": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "SCIENCE",
            "SCHEMA_FIXTURE"
          ],
          "type": "string"
        },
        "schema_id": {
          "const": "IG_STORAGE_BLOCK_V1"
        },
        "stored_content": {
          "$ref": "#/$defs/ContentRef"
        }
      },
      "required": [
        "schema_id",
        "contract_version",
        "purpose",
        "ordinal",
        "decoded_offset",
        "decoded_content",
        "stored_content",
        "codec_ref",
        "extensions"
      ],
      "type": "object"
    },
    "CollectionPage": {
      "additionalProperties": false,
      "description": "Depth 0 contains SHARD entries; higher depth PAGE entries. Bounds and totals are cross-record checks, not proof by JSON Schema.",
