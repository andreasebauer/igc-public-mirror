      "type": "object"
    },
    "ExactRational": {
      "additionalProperties": false,
      "description": "Semantic validator must require gcd=1; zero value is represented as 0/1.",
      "properties": {
        "denominator": {
          "pattern": "^[1-9][0-9]*(?![\\s\\S])",
          "type": "string"
        },
        "numerator": {
          "pattern": "^(0|-?[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "type": "object"
    },
