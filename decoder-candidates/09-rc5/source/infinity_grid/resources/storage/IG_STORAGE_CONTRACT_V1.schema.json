              "type": "null"
            }
          ]
        },
        "extensions": {
          "items": {
            "$ref": "#/$defs/Extension"
          },
          "minItems": 0,
          "type": "array"
        },
        "failed_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "nonclaims": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "not_run_count": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin_mode": {
          "enum": [
            "FRESH_RECOMPUTE",
            "VERIFIED_RESTORED_BLOCK",
            "SOURCE_INTEGRITY_ONLY",
            "HISTORICAL_RESULT_ONLY",
            "SCHEMA_FIXTURE"
          ],
          "type": "string"
        },
        "outcome": {
          "enum": [
            "REPRODUCED",
            "DISCREPANCY",
            "OPEN",
            "NEGATIVE_REPRODUCED",
            "NOT_EVALUATED"
          ],
          "type": "string"
        },
        "passed_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "SCIENCE",
            "SCHEMA_FIXTURE"
          ],
          "type": "string"
        },
        "raw_attempt_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
          "type": "string"
        },
        "schema_id": {
          "const": "IG_STORAGE_COVERAGE_V1"
        },
        "science_execution": {
          "enum": [
            "NONE",
            "EXECUTED"
          ],
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "skipped_count": {
          "pattern": "^(0|[1-9][0-9]*)(?![\\s\\S])",
