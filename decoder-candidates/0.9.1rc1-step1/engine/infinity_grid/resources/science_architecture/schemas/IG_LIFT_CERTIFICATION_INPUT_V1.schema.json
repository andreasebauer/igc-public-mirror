{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IG Lift Certification Input V1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {"const": "IG_LIFT_CERTIFICATION_INPUT_V1"},
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "certificate_scope": {"enum": ["EXACT_CONTEXT_SUBSTITUTION", "OBSERVER_RELATIVE_FULL_ABSTRACTION", "SCOPED_TRANSITION_CONGRUENCE", "SOURCE_SCOPED_GRADUATION"]},
    "sufficiency_and_closure": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "representative_independence": {"type": "string", "minLength": 1},
    "observer_action_multiplicity_scope": {"type": "string", "minLength": 1},
    "canonicalization_rule": {"type": "string", "minLength": 1},
    "retained_relations_and_fields": {"type": "array", "items": {"type": "string"}},
    "authority_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "role": {"type": "string"},
          "scope": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "required": ["id", "version"]
      }
    },
    "premise_set_ref": {"type": "string", "minLength": 1},
    "reopen_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations_and_nonclaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "required": ["schema_id", "schema_version", "certificate_scope", "sufficiency_and_closure", "representative_independence", "observer_action_multiplicity_scope", "canonicalization_rule", "retained_relations_and_fields", "authority_refs", "premise_set_ref", "reopen_conditions", "limitations_and_nonclaims"]
}
