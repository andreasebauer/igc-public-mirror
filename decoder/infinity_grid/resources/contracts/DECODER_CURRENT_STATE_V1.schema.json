{
  "$id": "ig://schema/decoder-current-state/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of_utc": {"minLength": 1, "type": "string"},
    "authority_class": {"const": "CURRENT_CONTEXT"},
    "canonical_code": {
      "additionalProperties": false,
      "properties": {
        "baseline_decoder_version": {"const": "0.26.0"},
        "gate1_contract_release": {"type": "object"},
        "next_semantic_target": {"const": "0.27.0"},
        "semantic_delta_from_v0_26": {"const": "NONE"}
      },
      "required": ["baseline_decoder_version", "gate1_contract_release", "semantic_delta_from_v0_26", "next_semantic_target"],
      "type": "object"
    },
    "gate_status": {
      "additionalProperties": false,
      "properties": {
        "gate_0_baseline_freeze": {"const": "COMPLETE"},
        "gate_1_machine_contracts": {"const": "COMPLETE"},
        "gate_2_v0_26_oracle": {"const": "NEXT"},
        "v0_27_semantic_integration": {"const": "BLOCKED_UNTIL_LATER_GATES"}
      },
      "required": ["gate_0_baseline_freeze", "gate_1_machine_contracts", "gate_2_v0_26_oracle", "v0_27_semantic_integration"],
      "type": "object"
    },
    "hard_rules": {"items": {"type": "string"}, "type": "array"},
    "legacy_state_reconciliation": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {"type": "array"},
        "rule": {"type": "string"},
        "superseded_authority_files": {"items": {"type": "string"}, "type": "array"}
      },
      "required": ["conflicts", "superseded_authority_files", "rule"],
      "type": "object"
    },
    "operational_snapshot": {
      "additionalProperties": false,
      "properties": {
        "active_runs": {"type": "object"},
        "freshness": {"const": "HISTORICAL_SNAPSHOT_REQUIRES_LIVE_REFRESH"},
        "rule": {"type": "string"},
        "source": {"type": "string"}
      },
      "required": ["freshness", "source", "active_runs", "rule"],
      "type": "object"
    },
    "purpose": {"type": "string"},
    "schema_id": {"const": "IG_DECODER_CURRENT_STATE_V1"},
    "science_status": {"type": "object"},
    "state_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "state_version": {"const": "1.0.0"}
  },
  "required": [
    "schema_id", "state_version", "authority_class", "as_of_utc", "purpose", "canonical_code",
    "gate_status", "science_status", "operational_snapshot", "hard_rules", "legacy_state_reconciliation", "state_sha256"
  ],
  "type": "object"
}
